# Kiln Linux, mlrig: /etc/portage/package.use/kiln
# The kernel installer builds the start-up image and writes systemd-boot menu entries.
sys-kernel/installkernel dracut systemd systemd-boot
# systemd-boot comes with systemd, but only with this flag.
sys-apps/systemd boot
# Firefox needs this.
media-libs/libvpx postproc
# The top bar shows the network state.
gui-apps/waybar network
# The compilers themselves, at maximum.
sys-devel/gcc lto pgo
sys-devel/binutils pgo
dev-lang/rust lto
# PyTorch on the RTX 4090, with every option that works together on this machine.
# nccl and rocm are for AMD GPUs. mkl and opencl are left out for openblas and cuda.
sci-ml/pytorch cuda cusparselt distributed fbgemm flash gloo kineto memefficient mimalloc nnpack onednn openblas openmp qnnpack xnnpack
dev-util/nvidia-cuda-toolkit profiler
dev-libs/cutlass tools
sci-ml/tensorpipe cuda
sci-ml/gloo cuda
