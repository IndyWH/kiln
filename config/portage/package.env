# Kiln Linux, mlrig: /etc/portage/package.env
# Packages with their own settings. Format: category/package env-file
# The env files are in env/. Write the reason for any safer setting in lessons/build.md.
# Safer settings come from real build failures in step 11.
dev-python/uv rust-overfire.conf
sci-ml/* overfire.conf
sci-ml/pytorch pytorch-rtx4090.conf
sci-ml/torchvision torchvision-rtx4090.conf
sci-libs/openblas overfire.conf
dev-libs/sleef overfire.conf
dev-libs/mimalloc overfire.conf
dev-libs/cpuinfo overfire.conf
dev-libs/pthreadpool overfire.conf
dev-libs/asmjit overfire.conf
