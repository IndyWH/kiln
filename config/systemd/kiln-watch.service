[Unit]
Description=Kiln watch: daily read-only health check
Documentation=file:///home/indy/Projects/kiln/scripts/kiln-watch
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStartPre=-/usr/local/bin/kiln-agent-status watcher-start
ExecStart=/usr/local/bin/kiln-watch
ExecStopPost=-/usr/local/bin/kiln-agent-status watcher-done
Nice=10
IOSchedulingClass=idle
