{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": ["/usr/local/lib/kiln-guard/kiln_guard.py", "hook"],
            "timeout": 20,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
