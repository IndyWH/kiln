#!/bin/sh
# Kiln: the pull-down Claude Code window, on the middle mouse button.
# The first press opens Claude Code in ~/Projects/kiln, carrying on the last conversation.
# Later presses hide and show it. A hidden window keeps running, so work carries on.
# The window rules in ~/.config/hypr/config/kiln.lua put it on the hidden "sidekick" workspace.
if hyprctl -j clients | grep -q '"class": "kiln-sidekick"'; then
    # If the window was moved off its workspace (14 Nov 2026: a key sent it to the
    # scratchpad, and the button only flashed an empty pull-down), bring it back first.
    where=$(hyprctl -j clients | python3 -c 'import json, sys
for c in json.load(sys.stdin):
    if c["class"] == "kiln-sidekick":
        print(c["address"], c["workspace"]["name"]); break')
    if [ "${where#* }" != "special:sidekick" ]; then
        hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:sidekick\", window = \"address:${where%% *}\" })" >/dev/null
    fi
    exec hyprctl dispatch 'hl.dsp.workspace.toggle_special("sidekick")'
fi
# Claude Code by its full path: the desktop's PATH does not include ~/.local/bin.
# If it cannot start, the window stays open with a message instead of vanishing.
exec kitty --class kiln-sidekick --title "Kiln: Claude Code" --directory "$HOME/Projects/kiln" \
    sh -c '"$HOME/.local/bin/claude" --continue || "$HOME/.local/bin/claude" ||
           { echo; echo "Claude Code did not start. Press Enter to close."; read x; }'
