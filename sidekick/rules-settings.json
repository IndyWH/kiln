{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "/usr/local/lib/kiln-guard/kiln_rules.py",
              "pre"
            ],
            "timeout": 180,
            "onFailure": "block"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "/usr/local/lib/kiln-guard/kiln_rules.py",
              "post"
            ],
            "timeout": 180
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "/usr/local/lib/kiln-guard/kiln_rules.py",
              "post"
            ],
            "timeout": 180
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3",
            "args": [
              "/usr/local/lib/kiln-guard/kiln_rules.py",
              "session"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
